configuration {
    show-icons: false;
}

* {
    bg:      #0d0d0d;
    bg-alt:  #1a1a1a;
    fg:      #e0e0e0;
    border:  #333333;
    muted:   #666666;

    font: "JetBrainsMono Nerd Font 12";
}

window {
    background-color: @bg;
    border:           1px solid;
    border-color:     @border;
    border-radius:    4px;
    width:            240px;
    padding:           12px;
}

mainbox {
    background-color: transparent;
    children: [ "listview" ];
}

listview {
    background-color: transparent;
    lines:            6;
    spacing:          4px;
    fixed-height:     false;
    dynamic:          false;
}

element {
    background-color: transparent;
    text-color:        @muted;
    padding:            8px 10px;
    border-radius:      4px;
}

element selected {
    background-color: @bg-alt;
    text-color:        @fg;
}

element-text {
    background-color: transparent;
    text-color:        inherit;
    vertical-align:    0.5;
}